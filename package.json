{
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "test": "node --test loop/test/*.test.ts"
  },
  "devDependencies": {
    "@ref0/workspace": "0.0.0-placeholder",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0",
  "ref0-workspace": {
    "commitScopes": [
      "reports",
      "loop",
      "cards",
      "research",
      "ci",
      "docs"
    ],
    "prePush": {
      "always": [
        "test"
      ]
    }
  }
}
